<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 のテストプロジェクトは実行形式でビルドする -->
    <OutputType>Exe</OutputType>
    <!-- テストメソッド名に日本語を使い、何を確かめているかを読みやすくする -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PulseMind.Core\PulseMind.Core.csproj" />
    <ProjectReference Include="..\..\src\PulseMind.Web\PulseMind.Web.csproj" />
    <ProjectReference Include="..\..\src\PulseMind.IoTBridge\PulseMind.IoTBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
