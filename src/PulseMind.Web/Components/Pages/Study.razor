@page "/study"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject StudySessionService Sessions
@inject TimeProvider Time

<PageTitle>学習の記録 - Pulse &amp; Mind Study</PageTitle>

<div class="page-head">
    <div>
        <h1>学習の記録</h1>
        <p>タイマーで計るか、あとから時間を入力して記録します。</p>
    </div>
    <a class="btn-pm primary" href="focus"><Icon Name="target" /> 集中モード</a>
</div>

@if (profile is null)
{
    <div class="empty">読み込み中…</div>
    return;
}

<div class="grid grid-12">
    <section class="card-pm w-12 accent-study">
        <header>
            <h2 class="card-title-icon accent-title"><Icon Name="calendar" /> この1年</h2>
            <span class="faint small">合計 <strong class="num">@Math.Round(yearMinutes / 60)</strong> 時間・学習した日 <strong class="num">@yearDays</strong> 日・最長 <strong class="num">@longestStreak</strong> 日連続</span>
        </header>
        <YearCalendar Days="year" Today="today" GoalMinutes="profile.DailyGoalMinutes" />
    </section>

    <section class="card-pm w-5 accent-study">
        <header><h2 class="card-title-icon accent-title"><Icon Name="timer" /> タイマー</h2></header>
        <StudyTimer Profile="profile" OnChanged="Reload" />
    </section>

    <section class="card-pm w-7 accent-study">
        <header><h2 class="card-title-icon accent-title"><Icon Name="edit" /> あとから入力</h2></header>
        <div class="stack">
            <div class="grid grid-3" style="gap:10px">
                <div class="field">
                    <label for="m-date">日付</label>
                    <input id="m-date" class="input-pm" type="date" max="@today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @bind="manualDate" />
                </div>
                <div class="field">
                    <label for="m-start">開始</label>
                    <input id="m-start" class="input-pm" type="time" @bind="manualStart" />
                </div>
                <div class="field">
                    <label for="m-end">終了</label>
                    <input id="m-end" class="input-pm" type="time" @bind="manualEnd" />
                </div>
            </div>
            <p class="faint small" style="margin:-6px 0 0">終了が開始より前の時刻なら、翌日の時刻として扱います（例: 23:00〜1:00）。</p>
            <div class="grid grid-2" style="gap:10px">
                <div class="field">
                    <label for="m-subject">科目</label>
                    <input id="m-subject" class="input-pm" maxlength="@StudySession.SubjectMaxLength" placeholder="例: 英語長文" @bind="manualSubject" />
                </div>
                <div class="field">
                    <label for="m-note">メモ（任意）</label>
                    <input id="m-note" class="input-pm" maxlength="@StudySession.NoteMaxLength" @bind="manualNote" />
                </div>
            </div>
            <div class="field">
                <span class="field-label">集中度（任意）</span>
                <ScalePicker Kind="focus" Label="集中度" @bind-Value="manualFocus" />
            </div>
            <div class="row-pm">
                <button class="btn-pm primary" @onclick="AddManual" disabled="@busy">記録する</button>
                @if (!string.IsNullOrEmpty(ManualPreview))
                {
                    <span class="faint small">@ManualPreview</span>
                }
            </div>
            <Notice Kind="error" Message="@manualError" />
            <Notice Kind="success" Message="@manualDone" />
        </div>
    </section>

    <section class="card-pm w-5 accent-study">
        <header>
            <h2 class="card-title-icon accent-title"><Icon Name="chart" /> 科目の内訳</h2>
            <span class="faint small">直近30日</span>
        </header>
        <SubjectBreakdown Items="subjects" />
    </section>

    <section class="card-pm w-7 accent-study">
        <header><h2 class="card-title-icon accent-title"><Icon Name="study" /> 記録（直近7日間）</h2></header>
        @if (groups.Count == 0)
        {
            <div class="empty"><Icon Name="study" />まだ記録がありません。タイマーで最初の学習を記録しましょう。</div>
        }
        else
        {
            @foreach (var group in groups)
            {
                <div class="list-day"><span>@Format.Day(group.Key)</span><span class="num">@Format.Minutes(group.Sum(s => s.Minutes))</span></div>
                <ul class="list">
                    @foreach (var s in group)
                    {
                        <li>
                            <i class="dot" style="--c:@SubjectColors.For(s.Session.Subject)"></i>
                            <div class="grow">
                                <div class="title">@SubjectColors.Label(s.Session.Subject)</div>
                                <div class="meta">
                                    @Format.Time(s.StartLocal)〜@(s.Session.IsRunning ? "計測中" : Format.Time(s.EndLocal))
                                    @if (!string.IsNullOrEmpty(s.Session.Note))
                                    {
                                        <span>　@s.Session.Note</span>
                                    }
                                </div>
                            </div>
                            @if (s.Session.Focus is int f)
                            {
                                <span class="tag primary" title="集中度">集中 @f</span>
                            }
                            <span class="num" style="min-width:5em;text-align:right">@Format.Minutes(s.Minutes)</span>
                            @if (!s.Session.IsRunning)
                            {
                                <button class="btn-pm icon" aria-label="この記録を削除" title="削除" @onclick="() => deleting = s.Session"><Icon Name="trash" /></button>
                            }
                        </li>
                    }
                </ul>
            }
        }
    </section>
</div>

<ConfirmSheet Visible="deleting is not null" Title="この記録を削除しますか？" ConfirmText="削除する" Danger="true" Busy="busy"
              OnConfirm="Delete" OnCancel="() => deleting = null">
    <p class="muted" style="margin:0">削除した記録は元に戻せません。</p>
</ConfirmSheet>

@code {
    private sealed record Row(StudySession Session, DateTime StartLocal, DateTime EndLocal, double Minutes);

    private UserProfile? profile;
    private DateOnly today;
    private IReadOnlyDictionary<DateOnly, double> year = new Dictionary<DateOnly, double>();
    private double yearMinutes;
    private int yearDays, longestStreak;
    private IReadOnlyList<(string Subject, double Minutes)> subjects = [];
    private List<IGrouping<DateOnly, Row>> groups = [];
    private StudySession? deleting;
    private bool busy;

    private DateOnly manualDate;
    private TimeOnly? manualStart, manualEnd;
    private string? manualSubject, manualNote, manualError, manualDone;
    private int? manualFocus;

    protected override async Task OnInitializedAsync()
    {
        profile = await Me.GetAsync();
        today = TimeZones.LocalDate(Time.GetUtcNow().UtcDateTime, profile.Zone);
        manualDate = today;
        await Reload();
    }

    private async Task Reload()
    {
        if (profile is null) return;
        var days = await Sessions.DailyMinutesAsync(profile.UserId, today.AddDays(-370), today, profile.Zone);
        year = days;
        yearMinutes = days.Where(d => d.Key > today.AddDays(-365)).Sum(d => d.Value);
        yearDays = days.Count(d => d.Key > today.AddDays(-365) && d.Value >= 1);
        longestStreak = LongestStreak(days);

        var (monthFrom, monthTo) = TimeZones.LocalRangeUtc(today.AddDays(-29), today, profile.Zone);
        subjects = await Sessions.MinutesBySubjectAsync(profile.UserId, monthFrom, monthTo);

        var (fromUtc, toUtc) = TimeZones.LocalRangeUtc(today.AddDays(-6), today, profile.Zone);
        var now = Time.GetUtcNow().UtcDateTime;
        var sessions = await Sessions.ListAsync(profile.UserId, fromUtc, toUtc);
        groups = sessions
            .Select(s =>
            {
                var end = s.EndedAtUtc ?? now;
                return new Row(s, TimeZones.ToLocal(s.StartedAtUtc, profile.Zone), TimeZones.ToLocal(end, profile.Zone), (end - s.StartedAtUtc).TotalMinutes);
            })
            .GroupBy(r => DateOnly.FromDateTime(r.StartLocal))
            .OrderByDescending(g => g.Key)
            .ToList();
    }

    private static int LongestStreak(IReadOnlyDictionary<DateOnly, double> days)
    {
        int best = 0, current = 0;
        foreach (var (_, minutes) in days.OrderBy(d => d.Key))
        {
            current = minutes >= 1 ? current + 1 : 0;
            best = Math.Max(best, current);
        }
        return best;
    }

    /// <summary>入力中の時間帯から、記録される長さを先に見せる</summary>
    private string? ManualPreview => ManualRange() is var (s, e) ? $"{Format.Minutes((e - s).TotalMinutes)} として記録" : null;

    private (DateTime StartUtc, DateTime EndUtc)? ManualRange()
    {
        if (profile is null || manualStart is not TimeOnly start || manualEnd is not TimeOnly end) return null;
        var startLocal = manualDate.ToDateTime(start);
        var endLocal = manualDate.ToDateTime(end);
        if (endLocal <= startLocal) endLocal = endLocal.AddDays(1);
        try
        {
            return (TimeZoneInfo.ConvertTimeToUtc(startLocal, profile.Zone), TimeZoneInfo.ConvertTimeToUtc(endLocal, profile.Zone));
        }
        catch (ArgumentException)
        {
            return null; // 夏時間の切り替えで存在しない時刻
        }
    }

    private async Task AddManual()
    {
        if (profile is null) return;
        manualError = manualDone = null;
        if (ManualRange() is not var (startUtc, endUtc))
        {
            manualError = "開始と終了の時刻を入力してください。";
            return;
        }

        busy = true;
        try
        {
            var session = await Sessions.AddManualAsync(profile.UserId, new ManualStudyInput(startUtc, endUtc, manualSubject, manualFocus, manualNote));
            manualDone = $"{Format.Minutes(session.Duration!.Value.TotalMinutes)}の学習を記録しました。";
            manualStart = manualEnd = null;
            manualNote = null;
            manualFocus = null;
            await Reload();
        }
        catch (UserInputException ex)
        {
            manualError = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Delete()
    {
        if (profile is null || deleting is null) return;
        busy = true;
        try
        {
            await Sessions.DeleteAsync(profile.UserId, deleting.Id);
            deleting = null;
            await Reload();
        }
        finally
        {
            busy = false;
        }
    }
}
