@* ホーム画面（ログイン後）。主役は「今日」の大きな数字と 1日のリズム。ほかは大きさに強弱をつけたウィジェットで並べる *@
@inject CurrentUser Me
@inject StudySessionService Sessions
@inject DailyRecordService Records
@inject PulseMind.Core.Health.HeartRateIngestionService HeartRates
@inject TimeProvider Time

@if (profile is null)
{
    <div class="empty">読み込み中…</div>
    return;
}

<div class="page-head">
    <div>
        <span class="page-date">@Format.Day(today)</span>
        <h1>@Format.Greeting(nowLocal)、@(profile.Name)さん</h1>
    </div>
    @if (countdown is not null)
    {
        <a class="exam-pill" href="settings#exam">
            <span>@countdown.ExamName まで</span>
            <strong class="num">@countdown.DaysLeft</strong><span>日</span>
        </a>
    }
</div>

@if (!profile.OnboardingCompleted)
{
    <a class="onboard-banner" href="welcome">
        <Icon Name="target" />
        <span><strong>はじめての設定</strong>　ニックネーム・1日の目標・目指す試験を決めましょう（1分ほど）</span>
        <Icon Name="chevron-right" />
    </a>
}

<div class="grid grid-12">
    <section class="card-pm w-8 accent-study hero-today">
        <header>
            <h2 class="card-title-icon accent-title"><Icon Name="study" /> 今日</h2>
            <a href="study">記録を見る</a>
        </header>
        <div class="today-figure">
            <span class="big-figure">
                @if (Hours(todayMinutes) > 0)
                {
                    @Hours(todayMinutes)<small>時間</small>@MinutesPart(todayMinutes)<small>分</small>
                }
                else
                {
                    @((int)Math.Round(todayMinutes))<small>分</small>
                }
            </span>
            <div class="today-goal">
                <div class="capsule" role="img" aria-label="@($"目標 {Format.Minutes(profile.DailyGoalMinutes)} の {GoalPercent}%")">
                    <span style="width:@Math.Min(100, GoalPercent)%"></span>
                </div>
                <span class="small muted">目標 @Format.Minutes(profile.DailyGoalMinutes) の <strong class="num">@GoalPercent%</strong></span>
            </div>
        </div>
        <DayRhythm Day="today" Blocks="blocks" Heart="heartPoints" NowLocal="nowLocal" AriaLabel="今日の学習と心拍" />
        @if (subjectsToday.Count > 0)
        {
            <div class="legend">
                @foreach (var (subject, minutes) in subjectsToday)
                {
                    <span><i class="dot" style="--c:@SubjectColors.For(subject)"></i>@SubjectColors.Label(subject) <span class="faint num">@Format.Minutes(minutes)</span></span>
                }
                @if (heartPoints.Count > 0)
                {
                    <span><i class="line-key"></i>心拍</span>
                }
            </div>
        }
    </section>

    <section class="card-pm w-4 accent-study">
        <header><h2 class="card-title-icon accent-title"><Icon Name="timer" /> タイマー</h2></header>
        <StudyTimer Profile="profile" OnChanged="ReloadStudy" />
        <a class="btn-pm tinted block" style="margin-top:10px" href="focus"><Icon Name="target" /> 集中モードで開く</a>
    </section>

    <section class="card-pm w-3 accent-mood">
        @if (countdown is not null)
        {
            <header><h2 class="card-title-icon accent-title"><Icon Name="calendar" /> @countdown.ExamName</h2></header>
            <div class="metric">
                <span class="value">あと @countdown.DaysLeft<small>日</small></span>
                <span class="sub">@Format.Day(countdown.ExamDate)</span>
            </div>
            @if (countdown.ProjectedHours is double hours)
            {
                <p class="small muted" style="margin:10px 0 0">今のペースなら、試験までにあと約 <strong class="num">@Math.Round(hours)</strong> 時間</p>
            }
        }
        else
        {
            <header><h2 class="card-title-icon accent-title"><Icon Name="calendar" /> 試験まで</h2></header>
            <p class="small muted">目指す試験の日を決めると、残りの日数と今のペースでの見込みを表示します。</p>
            <a class="btn-pm tinted" href="settings#exam">試験を設定</a>
        }
    </section>

    <section class="card-pm w-3 accent-pulse">
        <header><h2 class="card-title-icon accent-title"><Icon Name="flame" /> 連続</h2></header>
        <div class="metric">
            <span class="value">@streak<small>日</small></span>
            <span class="sub">@(streak == 0 ? "今日から始めましょう" : todayMinutes > 0 ? "今日も記録できています" : "今日勉強すると更新されます")</span>
        </div>
    </section>

    <section class="card-pm w-6 accent-study">
        <header>
            <h2 class="card-title-icon accent-title"><Icon Name="chart" /> 直近7日間</h2>
            <a href="review">振り返りカード</a>
        </header>
        <p class="small muted" style="margin:-6px 0 4px">合計 <strong class="num">@Format.Minutes(week.Sum(i => i.Value))</strong>・1日平均 <strong class="num">@Format.Minutes(weekAverage)</strong></p>
        <BarChart Items="week" Goal="profile.DailyGoalMinutes" GoalLabel="@($"目標 {Format.Minutes(profile.DailyGoalMinutes)}")"
                  ValueText="Format.MinutesShort" AriaLabel="直近7日間の学習時間" Height="170" />
    </section>

    <section class="card-pm w-6 accent-sleep">
        <header>
            <h2 class="card-title-icon accent-title"><Icon Name="moon" /> 今日のコンディション</h2>
            <a href="daily">詳しく記録</a>
        </header>
        <div class="stack">
            <div class="field">
                <label for="dash-sleep">昨夜の睡眠</label>
                <div class="input-with-unit">
                    <input id="dash-sleep" class="input-pm num" type="number" min="0" max="24" step="0.25" inputmode="decimal" placeholder="7" @bind="sleepHours" />
                    <span>時間</span>
                </div>
            </div>
            <div class="field">
                <span class="field-label">気分</span>
                <ScalePicker Kind="mood" Label="今日の気分" @bind-Value="mood" />
            </div>
            <div class="row-pm">
                <button class="btn-pm primary" @onclick="SaveCondition" disabled="@savingCondition">保存</button>
                @if (conditionSaved)
                {
                    <span class="small saved-mark"><Icon Name="check" /> 保存しました</span>
                }
            </div>
            <Notice Kind="error" Message="@conditionError" />
        </div>
    </section>

    <section class="card-pm w-6 accent-pulse">
        <header>
            <h2 class="card-title-icon accent-title"><Icon Name="heart" Class="@(heartPoints.Count > 0 ? "beat" : null)" /> 心拍</h2>
            @if (heartPoints.Count > 0)
            {
                <span class="faint small">最新 @Format.Time(heartPoints[^1].Local)</span>
            }
        </header>
        @if (heartPoints.Count == 0)
        {
            <div class="empty">
                <Icon Name="pulse" />
                今日の心拍の記録はまだありません。<br />
                <a href="devices">センサーやヘルスケアをつなぐ</a>
            </div>
        }
        else
        {
            <div class="row-pm" style="gap:28px;margin-bottom:6px">
                <div class="metric"><span class="label">最新</span><span class="value">@Math.Round(heartPoints[^1].Average)<small>bpm</small></span></div>
                <div class="metric"><span class="label">今日の平均</span><span class="value" style="font-size:1.375rem">@Math.Round(heartPoints.Average(p => p.Average))<small>bpm</small></span></div>
            </div>
            <HeartRateChart Points="heartPoints" From="chartFrom" To="chartTo" Height="150" AriaLabel="今日の心拍数" />
        }
    </section>
</div>

@code {
    private UserProfile? profile;
    private DateTime nowLocal;
    private DateOnly today;
    private double todayMinutes, weekAverage;
    private int streak;
    private IReadOnlyList<BarItem> week = [];
    private IReadOnlyList<RhythmBlock> blocks = [];
    private IReadOnlyList<(string Subject, double Minutes)> subjectsToday = [];
    private Countdown? countdown;

    private double? sleepHours;
    private int? mood;
    private bool savingCondition, conditionSaved;
    private string? conditionError;

    private IReadOnlyList<HeartRatePoint> heartPoints = [];
    private DateTime chartFrom, chartTo;

    private int GoalPercent => profile is null || profile.DailyGoalMinutes == 0 ? 0 : (int)Math.Round(todayMinutes * 100 / profile.DailyGoalMinutes);

    private static int Hours(double minutes) => (int)Math.Round(minutes) / 60;

    private static string MinutesPart(double minutes) => ((int)Math.Round(minutes) % 60).ToString("00", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        profile = await Me.GetAsync();
        nowLocal = TimeZones.ToLocal(Time.GetUtcNow().UtcDateTime, profile.Zone);
        today = DateOnly.FromDateTime(nowLocal);

        await ReloadStudy();

        var record = await Records.GetAsync(profile.UserId, today);
        sleepHours = record?.SleepHours;
        mood = record?.Mood;

        var (fromUtc, toUtc) = TimeZones.LocalDayRangeUtc(today, profile.Zone);
        heartPoints = HeartRateView.ToPoints(await HeartRates.GetMinutesAsync(profile.UserId, fromUtc, toUtc), profile.Zone);
        if (heartPoints.Count > 0)
        {
            // 記録のある時間帯を中心に表示する（1日全体だと線が細くなりすぎるため）
            var first = heartPoints[0].Local;
            chartFrom = new DateTime(first.Year, first.Month, first.Day, first.Hour, 0, 0);
            chartTo = new DateTime(nowLocal.Year, nowLocal.Month, nowLocal.Day, nowLocal.Hour, 0, 0).AddHours(1);
            if (chartTo - chartFrom < TimeSpan.FromHours(3)) chartFrom = chartTo.AddHours(-3);
        }
    }

    private async Task ReloadStudy()
    {
        if (profile is null) return;
        nowLocal = TimeZones.ToLocal(Time.GetUtcNow().UtcDateTime, profile.Zone);
        var days = await Sessions.DailyMinutesAsync(profile.UserId, today.AddDays(-59), today, profile.Zone);
        todayMinutes = days[today];
        streak = await Sessions.StreakAsync(profile.UserId, today, profile.Zone);

        week = days.Where(d => d.Key > today.AddDays(-7))
            .Select(d => new BarItem(d.Key == today ? "今日" : Format.Weekday(d.Key), d.Value,
                $"{Format.Day(d.Key)} {Format.Minutes(d.Value)}", Highlight: d.Key == today, SubLabel: Format.ShortDay(d.Key)))
            .ToList();
        weekAverage = week.Average(i => i.Value);

        double recentAverage = days.Where(d => d.Key < today && d.Key >= today.AddDays(-14)).Select(d => d.Value).DefaultIfEmpty(0).Average();
        countdown = Countdown.Create(profile.ExamName, profile.ExamDate, today, recentAverage);

        var (fromUtc, toUtc) = TimeZones.LocalDayRangeUtc(today, profile.Zone);
        var now = Time.GetUtcNow().UtcDateTime;
        blocks = (await Sessions.ListAsync(profile.UserId, fromUtc, toUtc))
            .Select(s => new RhythmBlock(TimeZones.ToLocal(s.StartedAtUtc, profile.Zone),
                // 止め忘れのタイマーは、集計と同じく 12 時間で区切って描く
                TimeZones.ToLocal(s.EndedAtUtc ?? (now - s.StartedAtUtc > StudySessionService.MaxSessionLength ? s.StartedAtUtc + StudySessionService.MaxSessionLength : now), profile.Zone),
                s.Subject, s.IsRunning))
            .ToList();
        subjectsToday = await Sessions.MinutesBySubjectAsync(profile.UserId, fromUtc, toUtc);
    }

    private async Task SaveCondition()
    {
        if (profile is null) return;
        savingCondition = true;
        conditionSaved = false;
        conditionError = null;
        try
        {
            // 歩数やメモなど、ここで扱わない項目は今の値を残す
            var current = await Records.GetAsync(profile.UserId, today);
            await Records.SaveAsync(profile.UserId, new DailyRecordInput(today, sleepHours, current?.Steps, mood, current?.Note), profile.Zone);
            conditionSaved = true;
        }
        catch (UserInputException ex)
        {
            conditionError = ex.Message;
        }
        finally
        {
            savingCondition = false;
        }
    }
}
