@* 線画のアイコン。色は文字色（currentColor）を引き継ぐ *@
<svg class="@Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)Icons.Get(Name))</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public string? Class { get; set; }
}
