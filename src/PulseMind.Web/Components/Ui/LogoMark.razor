@* ロゴ: 学習（藍）から心拍（赤）へのグラデーションに、脈の線を重ねたもの。
   同じページに複数置いても、片方が非表示のときに色が消えないよう、グラデーションの ID を部品ごとに変える *@
<svg class="@Class" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="@gradientId" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#4656d6" />
            <stop offset="1" stop-color="#e5484d" />
        </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#@gradientId)" />
    <path d="M5.5 17.5h4.6l2.3-5.6 3.8 10.2 2.7-7 1.5 2.4h6.1" fill="none" stroke="#fff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" />
</svg>

@code {
    private readonly string gradientId = "pm-logo-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public string? Class { get; set; } = "brand-mark";
}
