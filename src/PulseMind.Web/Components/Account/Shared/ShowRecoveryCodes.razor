<StatusMessage Message="@StatusMessage" />
<h2>回復用コード</h2>
<Notice Kind="error">
    <strong>このコードは安全な場所に保管してください。</strong><br />
    認証アプリの入ったスマートフォンをなくしたときに、回復用コードがないとログインできなくなります。各コードは1回だけ使えます。
</Notice>
<ul class="recovery-codes" aria-label="回復用コード">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <li><code class="num">@recoveryCode</code></li>
    }
</ul>
<p class="muted small">この画面を閉じると、コードは二度と表示されません。メモするか、印刷して保管してください。</p>
<div class="row-pm">
    <a class="btn-pm primary" href="Account/Manage/TwoFactorAuthentication">2段階認証の設定に戻る</a>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
