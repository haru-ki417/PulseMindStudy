@page "/Account/Manage/RenamePasskey/{Id}"

@using PulseMind.Core.Data
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using System.Buffers.Text

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>パスキーの名前 - Pulse &amp; Mind Study</PageTitle>

@if (passkey?.Name is { } name)
{
    <h2>パスキーの名前を変更</h2>
    <p class="muted">「@name」の新しい名前を入力してください。</p>
}
else
{
    <h2>パスキーに名前を付ける</h2>
    <p class="muted">どの端末のパスキーか分かるように、名前を付けてください（例: 「iPhone」「自宅のパソコン」）。</p>
}
<EditForm Model="Input" OnValidSubmit="Rename" FormName="rename-passkey" method="post" class="stack form-narrow">
    <DataAnnotationsValidator />
    <div class="field">
        <label for="Input.Name">パスキーの名前</label>
        <InputText @bind-Value="Input.Name" id="Input.Name" class="input-pm" aria-required="true" placeholder="例: iPhone" />
        <ValidationMessage For="() => Input.Name" />
    </div>
    <div class="row-pm">
        <button type="submit" class="btn-pm primary">保存</button>
        <a class="btn-pm ghost" href="Account/Manage/Passkeys">キャンセル</a>
    </div>
</EditForm>

@code {
    private ApplicationUser? user;
    private UserPasskeyInfo? passkey;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public string? Id { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = (await UserManager.GetUserAsync(HttpContext.User))!;
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        byte[] credentialId;
        try
        {
            credentialId = Base64Url.DecodeFromChars(Id);
        }
        catch (FormatException)
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", "エラー: パスキーの指定が正しくありません。", HttpContext);
            return;
        }

        passkey = await UserManager.GetPasskeyAsync(user, credentialId);
        if (passkey is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", "エラー: 指定されたパスキーが見つかりませんでした。", HttpContext);
            return;
        }
    }

    private async Task Rename()
    {
        passkey!.Name = Input.Name;
        var result = await UserManager.AddOrUpdatePasskeyAsync(user!, passkey);
        if (!result.Succeeded)
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", "エラー: パスキーの名前を変更できませんでした。", HttpContext);
            return;
        }

        RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", "パスキーの名前を保存しました。", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "{0}を入力してください。")]
        [StringLength(200, ErrorMessage = "{0}は{1}文字以内で入力してください。")]
        [Display(Name = "パスキーの名前")]
        public string Name { get; set; } = "";
    }
}
