@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using PulseMind.Core.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>アカウントの削除 - Pulse &amp; Mind Study</PageTitle>

<h2>アカウントの削除</h2>
<StatusMessage Message="@message" />

<Notice Kind="error">
    <strong>この操作は取り消せません。</strong><br />
    アカウントを削除すると、次のデータがすべて完全に削除され、あとから復元することはできません。
</Notice>
<ul class="delete-list">
    <li>学習の記録（学習時間・タイマーの履歴）</li>
    <li>毎日の記録（気分・睡眠・歩数など）</li>
    <li>心拍数のデータ</li>
    <li>登録した機器（Arduino などのデバイス）</li>
    <li>アカウント情報（メールアドレス・パスワード・パスキー・2段階認証の設定）</li>
</ul>
<p class="muted small">必要なデータがある場合は、削除する前に「<a href="Account/Manage/PersonalData">個人データ</a>」からダウンロードしてください。</p>

<EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post" class="stack form-narrow">
    <DataAnnotationsValidator />
    @if (requirePassword)
    {
        <div class="field">
            <label for="Input.Password">確認のため、パスワードを入力してください</label>
            <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="input-pm" autocomplete="current-password" aria-required="true" />
            <ValidationMessage For="() => Input.Password" />
        </div>
    }
    <div class="row-pm">
        <button class="btn-pm danger solid" type="submit"><Icon Name="trash" /> すべてのデータを削除して退会する</button>
        <a class="btn-pm ghost" href="Account/Manage/PersonalData">キャンセル</a>
    </div>
</EditForm>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }
        requirePassword = await UserManager.HasPasswordAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (requirePassword && !await UserManager.CheckPasswordAsync(user, Input.Password))
        {
            message = "エラー: パスワードが正しくありません。";
            return;
        }

        var result = await UserManager.DeleteAsync(user);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException("Unexpected error occurred deleting user.");
        }

        await SignInManager.SignOutAsync();

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' deleted themselves.", userId);

        RedirectManager.RedirectToCurrentPage();
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        [Display(Name = "パスワード")]
        public string Password { get; set; } = "";
    }
}
