@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using PulseMind.Core.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>個人データ - Pulse &amp; Mind Study</PageTitle>

<h2>個人データ</h2>
<StatusMessage />
<p class="muted">このアプリに保存されているあなたのデータは、いつでもダウンロードしたり、アカウントごと削除したりできます。</p>

<section class="section-pm">
    <h3>データのダウンロード</h3>
    <p class="muted small">学習・毎日の記録・心拍・機器・アカウントの設定を、表計算ソフトで開ける CSV と JSON（zip）で受け取れます。</p>
    <form action="Account/Manage/DownloadPersonalData" method="post">
        <AntiforgeryToken />
        <button class="btn-pm" type="submit"><Icon Name="download" /> すべてのデータをダウンロード（zip）</button>
    </form>
</section>

<section class="section-pm danger-zone">
    <h3>アカウントの削除</h3>
    <p class="muted small">アカウントを削除すると、学習記録・毎日の記録・心拍データ・登録した機器を含むすべてのデータが完全に削除され、元に戻せません。</p>
    <a href="Account/Manage/DeletePersonalData" class="btn-pm danger"><Icon Name="trash" /> アカウントを削除</a>
</section>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
