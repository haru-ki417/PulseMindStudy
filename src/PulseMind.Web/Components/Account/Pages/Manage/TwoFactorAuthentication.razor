@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using PulseMind.Core.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>2段階認証 - Pulse &amp; Mind Study</PageTitle>

<h2>2段階認証</h2>
<p class="muted">ログインのときに、パスワードに加えてスマートフォンの認証アプリに表示されるコードを入力します。パスワードが漏れても、他人にログインされにくくなります。</p>
<StatusMessage />
@if (canTrack)
{
    <div class="stack">
        <div class="row-pm">
            <span class="field-label">現在の状態</span>
            @if (is2faEnabled)
            {
                <span class="tag primary"><Icon Name="check" /> 有効</span>
            }
            else
            {
                <span class="tag">無効</span>
            }
        </div>

        @if (is2faEnabled)
        {
            if (recoveryCodesLeft == 0)
            {
                <Notice Kind="error">
                    <strong>回復用コードが残っていません。</strong><br />
                    回復用コードでログインするには、<a href="Account/Manage/GenerateRecoveryCodes">新しい回復用コードを発行</a>してください。
                </Notice>
            }
            else if (recoveryCodesLeft == 1)
            {
                <Notice Kind="error">
                    <strong>回復用コードが残り1個です。</strong><br />
                    <a href="Account/Manage/GenerateRecoveryCodes">新しい回復用コードを発行</a>できます。
                </Notice>
            }
            else if (recoveryCodesLeft <= 3)
            {
                <Notice Kind="info">
                    <strong>回復用コードが残り@(recoveryCodesLeft)個です。</strong><br />
                    早めに<a href="Account/Manage/GenerateRecoveryCodes">新しい回復用コードを発行</a>しておくと安心です。
                </Notice>
            }

            <div class="row-pm">
                @if (isMachineRemembered)
                {
                    <form @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="btn-pm">このブラウザの記憶を解除</button>
                    </form>
                }
                <a href="Account/Manage/GenerateRecoveryCodes" class="btn-pm">回復用コードを再発行</a>
                <a href="Account/Manage/Disable2fa" class="btn-pm danger">2段階認証を無効にする</a>
            </div>
        }

        <section class="section-pm">
            <h3>認証アプリ</h3>
            @if (!hasAuthenticator)
            {
                <p class="muted small">Microsoft Authenticator や Google Authenticator などのアプリを使います。</p>
                <div class="row-pm">
                    <a href="Account/Manage/EnableAuthenticator" class="btn-pm primary"><Icon Name="plus" /> 認証アプリを追加</a>
                </div>
            }
            else
            {
                <div class="row-pm">
                    <a href="Account/Manage/EnableAuthenticator" class="btn-pm primary">認証アプリを設定</a>
                    <a href="Account/Manage/ResetAuthenticator" class="btn-pm">認証アプリをリセット</a>
                </div>
            }
        </section>
    </div>
}
else
{
    <Notice Kind="error">
        <strong>プライバシーとCookieの方針に同意していません。</strong><br />
        2段階認証を有効にするには、方針への同意が必要です。
    </Notice>
}

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "このブラウザの記憶を解除しました。次にこのブラウザでログインするときは、確認コードの入力が必要です。",
            HttpContext);
    }
}
