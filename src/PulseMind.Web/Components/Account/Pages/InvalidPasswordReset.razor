@page "/Account/InvalidPasswordReset"

<PageTitle>リンクが無効です - Pulse &amp; Mind Study</PageTitle>

<div class="auth-wrap">
    <div class="auth-card">
        <h1>リンクが無効です</h1>
        <Notice Kind="error" Message="パスワード再設定用のリンクが正しくないか、有効期限が切れています。" />
        <p class="muted">お手数ですが、もう一度パスワードの再設定をお申し込みください。</p>
        <a class="btn-pm primary block" href="Account/ForgotPassword">再設定をやり直す</a>
    </div>
    <p class="auth-links"><a href="Account/Login">ログイン画面に戻る</a></p>
</div>
