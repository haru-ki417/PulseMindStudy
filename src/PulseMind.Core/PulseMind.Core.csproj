<Project Sdk="Microsoft.NET.Sdk">

  <!--
    画面に依存しないロジックとデータ設計。
    ドメインモデル、データベース（EF Core）、集計・分析・取り込みの処理を含み、単体テストの対象になる。
  -->
  <PropertyGroup>
    <RootNamespace>PulseMind.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PulseMind.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

</Project>
